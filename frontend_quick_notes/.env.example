# React app environment variables for Quick Notes

# Optional REST API base (Next.js /api/notes or JSONPlaceholder)
# REACT_APP_API_BASE=http://localhost:3001
# REACT_APP_API_BASE=https://jsonplaceholder.typicode.com

# Feature flags in JSON form
# Example enabling Supabase direct + realtime
REACT_APP_FEATURE_FLAGS={"useSupabaseDirect":false}

# Supabase (used only when useSupabaseDirect is true)
# REACT_APP_SUPABASE_URL=
# REACT_APP_SUPABASE_ANON_KEY=

# Optional runtime node env
# REACT_APP_NODE_ENV=development
