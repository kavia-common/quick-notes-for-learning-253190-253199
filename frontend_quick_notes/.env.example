# Optional backend base URL for future LMS/API integration (leave empty to use local storage)
REACT_APP_API_BASE=

# Alternative URLs (not currently used directly but reserved)
REACT_APP_BACKEND_URL=
REACT_APP_FRONTEND_URL=
REACT_APP_WS_URL=

# Node environment (development|production|test)
REACT_APP_NODE_ENV=development

# Build/runtime toggles (respected by deployment environment)
REACT_APP_NEXT_TELEMETRY_DISABLED=true
REACT_APP_ENABLE_SOURCE_MAPS=false
REACT_APP_PORT=3000
REACT_APP_TRUST_PROXY=false
REACT_APP_LOG_LEVEL=info
REACT_APP_HEALTHCHECK_PATH=/health

# Feature flags as JSON string, e.g. {"useRemoteApi":false,"enableMarkdown":false}
REACT_APP_FEATURE_FLAGS={"useRemoteApi": false}

# Experiments toggle
REACT_APP_EXPERIMENTS_ENABLED=false
